+#[test]
+fn darwin_host_binding_rejections_keep_the_image_memory_total() {
+    let counters = Counters::new();
+    for (cause, bytes) in [
+        (OverCause::HostTextureBounds, 64),
+        (OverCause::HostBindingType, 128),
+        (OverCause::HostBindingSize, 256),
+    ] {
+        counters.over_copied(bytes, true, cause);
+        counters.copied_host_texture(crate::HostTextureSource::Linear, bytes, true, false, cause);
+    }
+    let metrics = counters.metrics();
+    assert_eq!((metrics.over_copies_image_memory, metrics.over_copy_bytes_image_memory), (3, 448));
+    assert_eq!(counters.darwin_linear_texture_copy_causes(), [0, 0, 0, 0, 0, 64, 128, 256]);
+}
