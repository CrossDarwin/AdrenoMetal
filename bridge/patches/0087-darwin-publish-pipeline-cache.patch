+    /// Write the current pipeline cache and queued lowerings to this device's cache directory.
+    pub fn publish_pipeline_cache(&self) -> bool {
+        let (send, receive) = std::sync::mpsc::sync_channel(1);
+        self.shared.core.reaper.give(crate::reaper::Job::PublishCache(send));
+        receive.recv_timeout(std::time::Duration::from_secs(15)).unwrap_or(false)
+    }
+
+    /// Merge a compatible pipeline cache made available by the device's cache reader.
+    pub fn merge_external_pipeline_cache(&self) -> bool {
+        let core = &self.shared.core;
+        let merged = core.caches.merge_external(&core.device);
+        if merged {
+            core.reaper.poke();
+        }
+        merged
+    }
