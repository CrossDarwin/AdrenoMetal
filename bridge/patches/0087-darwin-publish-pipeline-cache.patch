+    /// Persist the worker's completed pipelines on the reaper.
+    pub(crate) fn publish(&self, device: &ash::Device, counters: &Counters) -> bool {
+        let Some(alone) = self.alone() else { return false };
+        let Some(path) = self.blob_to_write() else { return false };
+        let Some(current) = lock(&self.pipelines).current.clone() else { return false };
+        // SAFETY: the cache belongs to this device, and the exclusive guard bars creations.
+        let Ok(data) = (unsafe { device.get_pipeline_cache_data(current.0) }) else { return false };
+        drop(alone);
+        let size = data.len() as u64;
+        if size > self.bound.load(Relaxed) || write_whole(path, &[&frame(&data), &data]).is_err() {
+            return false;
+        }
+        counters.cache_written(24 + size);
+        lock(&self.pipelines).written = size;
+        true
+    }
+
+    /// Merge the compatible blob from the consumer's read-only layer.
+    pub(crate) fn merge_external(&self, device: &ash::Device) -> bool {
+        let Some(header) = self.header.get() else { return false };
+        let Some(lookup) = &self.lookup else { return false };
+        let name = blob_name(header);
+        let Some(file) = lookup.read(&name) else { return false };
+        let data = unframe(&file).filter(|data| {
+            data.starts_with(header) && data.len() as u64 <= self.bound.load(Relaxed)
+        });
+        let Some(data) = data else {
+            lookup.verdict(&name, false, file.len() as u64);
+            return false;
+        };
+        // SAFETY: the checked blob was made for this device's pipeline cache header.
+        let Some(source) = (unsafe { make_cache(device, data) }) else {
+            lookup.verdict(&name, false, file.len() as u64);
+            return false;
+        };
+        let made = self.alone().is_some_and(|_alone| {
+            let pipelines = lock(&self.pipelines);
+            !pipelines.seeding && pipelines.current.as_ref().is_some_and(|current| {
+                // SAFETY: both caches belong to this device and are not in use.
+                unsafe { device.merge_pipeline_caches(current.0, &[source]) }.is_ok()
+            })
+        });
+        // SAFETY: the merge is synchronous and no other thread receives source.
+        unsafe { device.destroy_pipeline_cache(source, None) };
+        if made {
+            lookup.verdict(&name, true, file.len() as u64);
+            self.created.store(host_time(), Relaxed);
+            self.grown.store(true, SeqCst);
+        }
+        made
+    }
