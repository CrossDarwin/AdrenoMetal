+fn device_sampler_descriptor(
+    descriptor: &SamplerDescriptor,
+    renderbox_compatibility: bool,
+) -> Result<SamplerDescriptor, Error> {
+    let cubic = SamplerMinMagFilter::Cubic;
+    if ![descriptor.min_filter, descriptor.mag_filter].contains(&cubic) {
+        return Ok(*descriptor);
+    }
+    if renderbox_compatibility
+        && descriptor.min_filter == cubic
+        && descriptor.mag_filter == cubic
+        && descriptor.mip_filter == SamplerMipFilter::NotMipmapped
+        && descriptor.normalized_coordinates
+        && descriptor.lod_average
+        && descriptor.compare_function == CompareFunction::Never
+        && descriptor.max_anisotropy == 1
+        && [descriptor.s_address_mode, descriptor.t_address_mode, descriptor.r_address_mode]
+            == [MetalAddressMode::ClampToEdge; 3]
+    {
+        let mut effective = *descriptor;
+        effective.min_filter = SamplerMinMagFilter::Linear;
+        effective.mag_filter = SamplerMinMagFilter::Linear;
+        return Ok(effective);
+    }
+    Err(Error::Unsupported(Gap::CubicSampler))
+}
+
+#[cfg(test)]
+#[test]
+fn renderbox_cubic_sampler_uses_linear_on_ios() {
+    let ordinary = SamplerDescriptor::new();
+    let mut renderbox = ordinary;
+    renderbox.min_filter = SamplerMinMagFilter::Cubic;
+    renderbox.mag_filter = SamplerMinMagFilter::Cubic;
+    renderbox.lod_average = true;
+    let effective = device_sampler_descriptor(&renderbox, true).unwrap();
+    assert_eq!(effective.min_filter, SamplerMinMagFilter::Linear);
+    assert_eq!(effective.mag_filter, SamplerMinMagFilter::Linear);
+    assert_ne!(SamplerWord::of(&effective).0, SamplerWord::of(&renderbox).0);
+    assert_eq!(device_sampler_descriptor(&ordinary, true).unwrap(), ordinary);
+    assert!(device_sampler_descriptor(&renderbox, false).is_err());
+    renderbox.mip_filter = SamplerMipFilter::Linear;
+    assert!(device_sampler_descriptor(&renderbox, true).is_err());
+}
